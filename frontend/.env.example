# Base URL of the JobTrack API as seen from the browser.
# Leave empty in development: Vite proxies /api to the backend (see vite.config.js).
# Set it when the SPA is served from a different origin than the API, e.g.
#   VITE_API_BASE_URL=https://jobtrack-api.up.railway.app/api
VITE_API_BASE_URL=

# Where the dev server forwards /api requests.
VITE_BACKEND_URL=http://localhost:8080
