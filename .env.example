# Copy to `.env` next to docker-compose.yml and adjust before `docker compose up`.
# Every value below has a working default in docker-compose.yml; this file exists
# so the demo can be started without editing the compose file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=jobtrack
POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=jobtrack

# --- API --------------------------------------------------------------------
# REQUIRED in production: HMAC-SHA256 signing key, at least 32 characters.
# The default below is for local containers only - generate your own with:
#   openssl rand -base64 48
APP_JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
APP_JWT_ACCESS_TTL=30m
APP_JWT_REFRESH_TTL=7d

# Browser origins allowed to call the API directly (the containerised frontend
# is same-origin through nginx and does not need CORS).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Seed a demo user (demo@jobtrack.local / Demo1234!) and an admin
# (admin@jobtrack.local / Admin1234!) with sample data on first start.
APP_SEED_DEMO_DATA=true

# E-mail reminders stay off unless an SMTP server is configured.
APP_REMINDERS_EMAIL_ENABLED=false

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=8081
